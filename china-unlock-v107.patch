+                        .foregroundStyle(.primary)
+                }
+                ProgressView(value: progress)
+                    .tint(.gestaltAccent)
+                HStack(spacing: 0) {
+                    ForEach(Array(steps.enumerated()), id: \.offset) { _, step in
+                        VStack(spacing: 4) {
+                            stepIcon(step.state)
+                            Text(step.title)
+                                .font(.caption2.weight(.medium))
+                                .foregroundStyle(step.state == .pending ? .tertiary : .secondary)
+                        }
+                        .frame(maxWidth: .infinity)
+                    }
+                }
+            }
+            .padding(14)
+        }
+    }
+
+    @ViewBuilder
+    private func stepIcon(_ state: ApplyStepState) -> some View {
+        switch state {
+        case .done:
+            Image(systemName: "checkmark.circle.fill")
+                .font(.title3)
+                .foregroundStyle(.green)
+        case .current:
+            Image(systemName: "arrow.right.circle.fill")
+                .font(.title3)
+                .foregroundStyle(Color.gestaltAccent)
+        case .pending:
+            Image(systemName: "circle")
+                .font(.title3)
+                .foregroundStyle(.tertiary)
+        case .failed:
+            Image(systemName: "xmark.circle.fill")
+                .font(.title3)
+                .foregroundStyle(.red)
+        }
+    }
+}
diff --git a/GestaltX/LiveGestaltProbe.swift b/GestaltX/LiveGestaltProbe.swift
new file mode 100644
index 0000000..32488f1
--- /dev/null
+++ b/GestaltX/LiveGestaltProbe.swift
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import Foundation
+
+/// Read-only live MobileGestalt probe (MGCopyAnswer). Device-only; every
+/// query returns `nil` in the simulator, and the checkup renders "live:
+/// unknown" there — never a faked value. The probe returns system
+/// capability answers, no user data.
+enum LiveGestaltProbe {
+    static func queryBool(_ key: String) -> Bool? {
+        (GXCopyLiveGestaltAnswer(key) as? NSNumber)?.boolValue
+    }
+
+    static func queryString(_ key: String) -> String? {
+        GXCopyLiveGestaltAnswer(key) as? String
+    }
+}
